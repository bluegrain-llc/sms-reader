              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "multiline"
                ]
              },
              "maxLength": {
                "default": 1000,
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              "input": {
                "type": "string",
                "const": "sms_code"
              }
            },
            "required": [
              "id",
              "label",
              "required",
              "type",
              "maxLength"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,128}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "label",
              "required",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,128}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "checkbox"
              }
            },
            "required": [
              "id",
              "label",
              "required",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,128}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "enum": [
                  "single_choice",
                  "multiple_choice"
                ]
              },
              "options": {
                "minItems": 1,
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "object",
