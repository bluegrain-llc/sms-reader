                  "fieldId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  }
                },
                "required": [
                  "fieldId",
                  "contains"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "fieldIds"
        ],
