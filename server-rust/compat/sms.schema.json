{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Markdown explanation shown on the phone; pass the contents of your .md file"
    },
    "title": {
      "description": "Short request title shown after the bot name",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "senderPhone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{5,14}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  },
  "required": [
    "purpose",
    "idempotencyKey"
  ],
  "additionalProperties": false
}
