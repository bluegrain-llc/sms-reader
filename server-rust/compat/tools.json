  {
    "name": "create_request",
    "description": "Create a form or multi-step wizard with optional conditional steps and one final submission. Requires owner approval for forms in Admin.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "fields": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "multiline"
                    ]
                  },
                  "maxLength": {
                    "default": 1000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4000
                  },
                  "input": {
                    "type": "string",
                    "const": "sms_code"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "checkbox"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "single_choice",
                      "multiple_choice"
                    ]
                  },
                  "options": {
                    "minItems": 1,
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "date"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "actions": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,128}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "type": "string",
                "enum": [
                  "submit",
                  "approve",
                  "decline",
                  "acknowledge"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "minItems": 2,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,128}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "body": {
                "type": "string",
                "maxLength": 4000
              },
              "fieldIds": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                }
              },
              "when": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "fieldId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                      },
                      "equals": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 4000
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    },
                    "required": [
                      "fieldId",
                      "equals"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "fieldId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                      },
                      "contains": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                      }
                    },
                    "required": [
                      "fieldId",
                      "contains"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "fieldIds"
            ],
            "additionalProperties": false
          }
        },
        "expiresInSeconds": {
          "default": 86400,
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "required": [
        "title",
        "body",
        "actions",
        "idempotencyKey"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "com.bluegrain.smsrelay/capability": "forms"
    }
