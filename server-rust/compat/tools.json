[
  {
    "name": "request_sms_code",
    "description": "Notify the owner’s registered phones about an upcoming SMS, queuing behind another caller if needed. Wait for ready before triggering SMS in a separate system. First approved response wins. Never triggers SMS.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Markdown explanation shown on the phone; pass the contents of your .md file"
        },
        "title": {
          "description": "Short request title shown after the bot name",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "senderPhone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{5,14}$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "required": [
        "purpose",
        "idempotencyKey"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "com.bluegrain.smsrelay/capability": "sms"
    }
  },
  {
    "name": "get_sms_code_request",
    "description": "Poll status. Code is available only after owner approval, for two minutes.",
