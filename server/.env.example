GOOGLE_CLOUD_PROJECT=your-firebase-project
PORT=8080
SERVICE_URL=https://your-cloud-run-service.run.app
SCHEDULER_EMAIL=sms-relay-scheduler@your-firebase-project.iam.gserviceaccount.com
# Browser origins are denied by default; native Android and nonbrowser MCP clients send none.
ALLOWED_ORIGINS=
# Enable prompt v2 delivery after deploying the Cloud Tasks queue and OIDC permissions.
DELIVERY_QUEUE=projects/your-firebase-project/locations/us-central1/queues/relay-delivery

# Public Firebase WEB app configuration for account deletion and focused service onboarding.
# Add the canonical service host to Firebase Auth authorized domains.
FIREBASE_WEB_CONFIG={"apiKey":"public-web-api-key","authDomain":"your-firebase-project.firebaseapp.com","projectId":"your-firebase-project","appId":"your-web-app-id"}
# Optional FIREBASE_WEB_CONFIG.androidInstallUrl: a public HTTPS Play/install page, without credentials.
# Verified operator/contact text; required before public distribution.
PRIVACY_CONTACT=

# Optional hosted OAuth. Supply a private 32-byte random key encoded as 64 lowercase hex characters
# through Secret Manager (never FIREBASE_WEB_CONFIG). Both runtimes/revisions must use the same key.
# OAUTH_CODE_KEY=
